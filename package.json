{
  "name": "@marcuwynu23/vite-plugin-env-banner",
  "version": "0.1.0",
  "description": "A Vite plugin that injects a draggable environment banner in non-production environments.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "vite",
    "vite-plugin",
    "environment",
    "banner"
  ],
  "license": "MIT",
  "author": "",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "vite": "^5.0.0 || ^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.17",
    "typescript": "^5.8.3",
    "vite": "^6.2.0"
  },
  "scripts": {
    "build": "tsc index.ts --outDir dist --declaration --module NodeNext --moduleResolution NodeNext --target ES2020 --skipLibCheck",
    "typecheck": "tsc index.ts --noEmit --module NodeNext --moduleResolution NodeNext --target ES2020 --skipLibCheck",
    "prepare": "npm run build"
  }
}
